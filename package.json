{
  "name": "box-breath",
  "private": true,
  "version": "1.0.0",
  "description": "Box breathing PWA: a beep at every phase change over a binaural beat.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "standalone": "node scripts/make-standalone.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
